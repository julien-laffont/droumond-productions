{
	"name": "droumond-productions",
	"type": "module",
	"version": "0.0.1",
	"private": true,
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"build:english": "ENGLISH=1 astro build --outDir dist-en",
		"preview": "astro preview",
		"check": "astro check",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "playwright test",
		"lighthouse": "node tests/lighthouse/run.ts",
		"verify": "npm run check && npm run format:check && npm run build && npm run build:english && npm test && npm run lighthouse",
		"astro": "astro"
	},
	"allowScripts": {
		"esbuild": true
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.5",
		"astro": "^7.4.12",
		"tailwindcss": "^4.3.5"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@axe-core/playwright": "^4.14.0",
		"@playwright/test": "^1.65.1",
		"@types/node": "^24.19.2",
		"lighthouse": "^13.6.0",
		"prettier": "^3.10.1",
		"prettier-plugin-astro": "^1.1.2",
		"typescript": "^6.0.3"
	}
}
