---
// The Equipa section of the home page (#15): a card per person of src/config/team.ts, with the
// photo (4:5), the name and the role; no individual pages, no biographies. Up to 5 per row on a
// desktop, up to 3 on a tablet (below 960 px, like Sobre's single column), and on a phone (below
// 600 px) one row that slides sideways, out to the screen's edges, so nobody sits alone there.
import { Image } from 'astro:assets';
import type { Language } from '../config/site';
import { TEAM, TEAM_IS_PROVISIONAL } from '../config/team';
import { dictionaries } from '../i18n';
import { sectionAnchor } from '../lib/paths';
import { teamGrid } from '../lib/team-grid';

interface Props {
	language: Language;
}

const { language } = Astro.props;
const t = dictionaries[language].team;
const anchor = sectionAnchor('team', language);

// The grid is decided here, at build time, from the number of people (src/lib/team-grid.ts):
// how many per row, and the slots a row is divided into. The CSS below only applies it.
const desktop = teamGrid(TEAM.length, 5);
const tablet = teamGrid(TEAM.length, 3);
const grid = {
	'--columns-desktop': desktop.columns,
	'--slots-desktop': desktop.slots,
	'--columns-tablet': tablet.columns,
	'--slots-tablet': tablet.slots,
};
---

<section
	id={anchor}
	aria-labelledby={`${anchor}-title`}
	class="px-gutter py-[clamp(48px,6vw,88px)]"
>
	<div class="mb-[clamp(20px,2.4vw,32px)] flex flex-wrap items-baseline gap-x-4 gap-y-2">
		<h2 id={`${anchor}-title`} class="type-label">
			{t.title}
		</h2>
		{TEAM_IS_PROVISIONAL && (
			<p class="border border-dashed border-current px-1.5 py-1 type-meta">{t.provisional}</p>
		)}
	</div>
	{/* Focusable, so that on a phone the row also slides with the keyboard's arrows. */}
	<ul class="team-grid" style={grid} tabindex="0" aria-labelledby={`${anchor}-title`}>
		{TEAM.map((person) => (
			<li class="reveal grid min-w-0 content-start gap-2.5">
				{/* Phones fetch the portraits as the page opens, since they sit near the screen: the
				    sizes match their real width and quality 70 keeps the page under its weight limit. */}
				<Image
					src={person.photo}
					alt={person.alt[language]}
					widths={[320, 480, 640]}
					sizes="(max-width: 600px) calc((100vw - 32px) * 0.62), (max-width: 960px) 31vw, 18vw"
					quality={70}
					class="aspect-[4/5] w-full bg-ink-2 object-cover"
				/>
				<h3 class="mt-1 text-[clamp(1.2rem,1.6vw,1.5rem)] type-name">{person.name}</h3>
				<p class="type-meta">{person.role[language]}</p>
			</li>
		))}
	</ul>
</section>

<style>
	/* Each row holds --columns people; a portrait is 1/--slots of the width. */
	.team-grid {
		--gap: clamp(12px, 1.4vw, 20px);
		--columns: var(--columns-desktop);
		--slots: var(--slots-desktop);
		display: grid;
		gap: var(--gap);
		grid-template-columns: repeat(
			var(--columns),
			calc((100% - (var(--slots) - 1) * var(--gap)) / var(--slots))
		);
	}
	@media (width < 960px) {
		.team-grid {
			--columns: var(--columns-tablet);
			--slots: var(--slots-tablet);
			row-gap: 28px;
		}
	}
	/* One row that slides sideways: it runs under the side margins to the screen's edges, and each
	   portrait (62% of the width between the margins) snaps to the left margin. */
	@media (width < 600px) {
		.team-grid {
			--left: max(var(--gutter), env(safe-area-inset-left, 0px));
			--right: max(var(--gutter), env(safe-area-inset-right, 0px));
			grid-template-columns: none;
			grid-auto-flow: column;
			grid-auto-columns: 62%;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			margin-inline: calc(-1 * var(--left)) calc(-1 * var(--right));
			padding: 0 var(--right) 10px var(--left);
			scroll-padding-inline: var(--left) var(--right);
		}
		.team-grid > li {
			scroll-snap-align: start;
		}
		/* At the screen's edges, the focus ring goes inside, or it would not show. */
		.team-grid:focus-visible {
			outline-offset: -2px;
		}
	}
</style>
