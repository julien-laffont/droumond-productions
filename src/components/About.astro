---
// The Sobre section: small text beside the team, one frame of film per person, name and role under
// each. The text is in src/content/about/<language>.md, the team in src/config/team.ts.
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import { IMAGE_FILES } from '../config/image-files';
import type { Language } from '../config/site';
import { TEAM } from '../config/team';
import { dictionaries } from '../i18n';
import { sectionAnchor } from '../lib/paths';
import Film from './Film.astro';

interface Props {
	language: Language;
}

const { language } = Astro.props;
const t = dictionaries[language].about;
const anchor = sectionAnchor('about', language);
const entry = await getEntry('about', language);
if (!entry) {
	throw new Error(`Missing src/content/about/${language}.md: Sobre exists in every language.`);
}
const { Content } = await render(entry);

/** Each frame's edge codes, numbered on from 27; the reel's name on every other top code. */
const frame = (index: number) => {
	const number = 27 + index;
	return {
		top: index % 2 ? `▸ ${number}` : `Droumond 2026 ▸ ${number}`,
		bottom: `${number}A`,
	};
};
---

<section
	id={anchor}
	aria-labelledby={`${anchor}-title`}
	class="grid grid-cols-[minmax(0,1fr)_minmax(0,1.7fr)] items-center gap-[clamp(28px,5vw,80px)] border-t border-paper/14 px-gutter py-[clamp(64px,9vw,128px)] max-[960px]:grid-cols-1"
>
	<div class="grid min-w-0 gap-[clamp(18px,2.4vw,28px)]">
		<h2 id={`${anchor}-title`} class="type-label">
			{t.title}
		</h2>
		{/* The Projects' names, in italics in the Markdown, show upright in amber. */}
		<div class="reveal grid max-w-[58ch] gap-[1em] text-sm leading-[1.75] [&_em]:text-amber [&_em]:not-italic">
			<Content />
		</div>
	</div>
	<ul class="reveal grid min-w-0 grid-cols-2 items-start" aria-label={t.team}>
		{TEAM.map((person, index) => (
			<li class="grid min-w-0 content-start gap-3.5">
				<Film {...frame(index)} side={12}>
					{/* The sizes match the photo's real width; quality 55 keeps the page under its weight limit. */}
					<Image
						src={person.photo}
						alt={person.alt[language]}
						{...IMAGE_FILES.portrait}
						sizes="(max-width: 960px) calc(50vw - 40px), 26vw"
						class="block aspect-[4/5] w-full bg-ink object-cover"
					/>
				</Film>
				<div class="grid gap-1.5 px-3">
					<h3 class="text-[clamp(1.25rem,1.8vw,1.75rem)] type-name">{person.name}</h3>
					<p class="type-meta">{person.role[language]}</p>
				</div>
			</li>
		))}
	</ul>
</section>
