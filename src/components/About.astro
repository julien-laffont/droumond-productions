---
// The Sobre section: small text beside one frame enlarged on film. Text, image and alt text come
// from src/content/about/<language>.md, so Julien can change them without touching code.
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import { IMAGE_FILES } from '../config/image-files';
import type { Language } from '../config/site';
import { dictionaries } from '../i18n';
import { sectionAnchor } from '../lib/paths';
import Film from './Film.astro';

interface Props {
	language: Language;
}

const { language } = Astro.props;
const t = dictionaries[language].about;
const anchor = sectionAnchor('about', language);
const entry = await getEntry('about', language);
if (!entry) {
	throw new Error(`Missing src/content/about/${language}.md: Sobre exists in every language.`);
}
const { Content } = await render(entry);
---

<section
	id={anchor}
	aria-labelledby={`${anchor}-title`}
	class="grid grid-cols-[minmax(0,1fr)_minmax(0,1.7fr)] items-center gap-[clamp(28px,5vw,80px)] border-t border-paper/14 px-gutter py-[clamp(64px,9vw,128px)] max-[960px]:grid-cols-1"
>
	<div class="grid min-w-0 gap-[clamp(18px,2.4vw,28px)]">
		<h2 id={`${anchor}-title`} class="type-label">
			{t.title}
		</h2>
		{/* The Projects' names, in italics in the Markdown, show upright in amber. */}
		<div class="reveal grid max-w-[58ch] gap-[1em] text-sm leading-[1.75] [&_em]:text-amber [&_em]:not-italic">
			<Content />
		</div>
	</div>
	<figure class="reveal grid min-w-0 gap-3">
		<Film top="Droumond 2026 ▸ 27" bottom="27A" side={12}>
			{/* The sizes match the photo's real width; quality 70 keeps the page under its weight limit. */}
			<Image
				src={entry.data.image}
				alt={entry.data.alt}
				{...IMAGE_FILES.about}
				sizes="(max-width: 960px) calc(100vw - 56px), 55vw"
				class="block aspect-video w-full bg-ink object-cover"
			/>
		</Film>
		<figcaption class="flex justify-between gap-4" aria-hidden="true">
			{t.caption.map((code) => (
				<span class="type-code">{code}</span>
			))}
		</figcaption>
	</figure>
</section>
