---
// The first screen of the home page (#13), as in the prototype of #5: light canvas with the
// background video, the logo symbol revealed at the exact centre, the name, and under it words
// that pass one at a time until the final line stays (after Rodeo FX). The animations run on each
// load of the home page, the only page that has them. Whoever asked for less motion sees it still:
// the still frame instead of the video, the logo drawn, only the final line.
import { getImage } from 'astro:assets';
import video from '../assets/hero/background.mp4';
import stillFrame from '../assets/hero/background-poster.jpg';
import logo from '../assets/logo.png';
import type { Language } from '../config/site';
import { dictionaries } from '../i18n';
import { sectionAnchor } from '../lib/paths';

interface Props {
	language: Language;
}

const { language } = Astro.props;
const t = dictionaries[language].hero;
const projectsTitle = dictionaries[language].projects.title;
/**
 * The video's first frame: behind the video until it plays, and in its place with less motion.
 * The first thing the page paints (LCP), so it loads at once.
 */
const still = await getImage({
	src: stillFrame,
	format: 'webp',
	loading: 'eager',
	fetchpriority: 'high',
});
---

<section
	aria-labelledby="hero-title"
	class="hero relative z-2 isolate grid min-h-[calc(100svh-var(--header-height)-28px)] grid-rows-[1fr_auto_1fr] justify-items-center px-gutter text-center text-ink"
>
	<div class="absolute inset-0 -z-1 overflow-hidden" aria-hidden="true">
		<img
			src={still.src}
			{...still.attributes}
			alt=""
			class="absolute inset-0 size-full object-cover"
		/>
		{/* Generated by code (#5), hosted here, never YouTube's player. The script below loads it
		    once the page has loaded; with less motion or without JavaScript, it never loads. */}
		<video
			muted
			autoplay
			loop
			playsinline
			poster={still.src}
			class="absolute inset-0 size-full object-cover motion-reduce:hidden"
			data-hero-video
			data-src={video}
		></video>
		{/* A light veil keeps the centre clear for the logo and the name; a vignette darkens the corners. */}
		<div class="hero-veil absolute inset-0"></div>
		<div class="hero-vignette absolute inset-0"></div>
		<div class="grain grain-moving"></div>
	</div>

	{/* The symbol, revealed by a mask: a ring follows the brush circle, then the monogram spreads
	    like ink, with a ragged edge. Any logo file with a transparent background works. */}
	<svg
		viewBox="0 0 400 400"
		role="img"
		aria-labelledby="hero-logo-title"
		class="row-start-2 block aspect-square w-[min(30vh,64vw,300px)] mix-blend-multiply"
	>
		<title id="hero-logo-title">{t.logo}</title>
		<defs>
			<filter id="hero-ink-edge" x="-20%" y="-20%" width="140%" height="140%">
				<feTurbulence
					type="fractalNoise"
					baseFrequency="0.045"
					numOctaves="2"
					seed="2"
					result="n"
				/>
				<feDisplacementMap
					in="SourceGraphic"
					in2="n"
					scale="22"
					xChannelSelector="R"
					yChannelSelector="G"
				/>
			</filter>
			<mask id="hero-logo-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="400" height="400">
				<g filter="url(#hero-ink-edge)">
					{/* From the heavy blob (about 8 o'clock), counter-clockwise to the dry end, like the brush. */}
					<circle
						class="hero-ring"
						cx="200"
						cy="200"
						r="150"
						fill="none"
						stroke="#fff"
						stroke-width="84"
						pathLength="360"
						transform="translate(200 200) rotate(165) scale(1 -1) translate(-200 -200)"
					/>
					<circle class="hero-core" cx="200" cy="200" r="128" fill="#fff" />
				</g>
			</mask>
		</defs>
		<image href={logo.src} x="30" y="30" width="340" height="340" mask="url(#hero-logo-mask)" />
	</svg>

	<div class="row-start-3 flex flex-col items-center gap-[clamp(8px,1.4vh,16px)] self-stretch pt-[clamp(10px,2vh,22px)] pb-[calc(var(--edge-height)*0.6+14px)]">
		<h1
			id="hero-title"
			class="hero-title text-[clamp(2.4rem,6vw,4.4rem)] leading-[0.88] tracking-[-0.005em] text-balance type-name"
		>
			Droumond Productions
		</h1>
		{/* The words pass in the same cell, hidden from screen readers; the final line is the text. */}
		<p class="grid justify-items-center pl-[0.26em] text-[clamp(0.8rem,1.2vw,1.05rem)] font-medium tracking-[0.26em] uppercase font-stretch-125%">
			{t.words.map((word, index) => (
				<span
					class="hero-word col-start-1 row-start-1 whitespace-nowrap"
					style={`--index: ${index}`}
					aria-hidden="true"
				>
					{word}
				</span>
			))}
			<span class="hero-line col-start-1 row-start-1" style={`--words: ${t.words.length}`}>
				{t.line}
			</span>
		</p>
		<a
			href={`#${sectionAnchor('projects', language)}`}
			class="mt-auto flex flex-col items-center gap-1 text-[11px] tracking-[0.22em] text-muted-on-canvas uppercase"
		>
			{projectsTitle} <span aria-hidden="true">↓</span>
		</a>
	</div>

	{/* WCAG 2.2.2: the video moves for more than 5 s, so it can be paused. The script shows the
	    button with the video. */}
	<button
		type="button"
		aria-pressed="false"
		hidden
		class="hero-pause absolute z-2 cursor-pointer rounded-full border border-ink/25 bg-canvas/72 px-3 py-[7px] text-xs/none font-medium text-ink motion-reduce:hidden aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-canvas"
		data-hero-pause
	>
		{t.pause}
	</button>
	<div class="edge edge-down" aria-hidden="true"></div>
</section>

<style>
	.hero {
		background: linear-gradient(
			115deg,
			var(--color-canvas-hi) 0%,
			var(--color-canvas) 48%,
			var(--color-canvas-lo) 100%
		);
	}
	.hero-veil {
		background: radial-gradient(
			ellipse 38% 44% at 50% 50%,
			color-mix(in srgb, var(--color-canvas) 78%, transparent),
			transparent 100%
		);
	}
	.hero-vignette {
		background: radial-gradient(
			ellipse at center,
			transparent 55%,
			color-mix(in srgb, var(--color-ink) 28%, transparent) 100%
		);
	}
	.hero-pause {
		right: max(var(--gutter), env(safe-area-inset-right, 0px));
		bottom: calc(var(--edge-height) * 0.6 + 14px);
	}

	/* At rest, everything is drawn and only the final line shows: that is what less motion sees.
	   The motion only starts from there when nobody asked for less of it. */
	.hero-word {
		display: none;
	}
	@media (prefers-reduced-motion: no-preference) {
		.hero-ring {
			stroke-dasharray: 360 360;
			animation: hero-ring 1.6s cubic-bezier(0.6, 0.05, 0.35, 1) 0.25s both;
		}
		.hero-core {
			transform-box: fill-box;
			transform-origin: center;
			animation: hero-core 0.65s var(--ease) 1.7s both;
		}
		.hero-title {
			animation: hero-rise 0.7s var(--ease) 2.05s both;
		}
		/* Each word in turn, 0.8 s apart, then the final line rises and stays. */
		.hero-word {
			display: block;
			opacity: 0;
			animation: hero-word 0.8s var(--ease) calc(2.5s + var(--index) * 0.8s) both;
		}
		.hero-line {
			animation: hero-rise 0.7s var(--ease) calc(2.5s + var(--words) * 0.8s) both;
		}
	}

	@keyframes hero-ring {
		from {
			stroke-dashoffset: 360;
		}
		to {
			stroke-dashoffset: 0;
		}
	}
	@keyframes hero-core {
		from {
			transform: scale(0);
		}
	}
	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
	}
	@keyframes hero-word {
		0% {
			opacity: 0;
			transform: translateY(8px);
		}
		25%,
		70% {
			opacity: 1;
			transform: none;
		}
		100% {
			opacity: 0;
			transform: translateY(-8px);
		}
	}
</style>

<script>
	// The background video only starts loading once the page has: it never competes with the still
	// frame, the first thing the page paints (LCP). Not with less motion, and not without
	// JavaScript, where it could not be paused: the still frame stays. The pause button comes with
	// the video; pressed means paused, and it follows the video, whatever paused it.
	const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
	const button = document.querySelector<HTMLButtonElement>('[data-hero-pause]');
	const src = video?.dataset.src;
	if (video && button && src && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		video.addEventListener('play', () => button.setAttribute('aria-pressed', 'false'));
		video.addEventListener('pause', () => button.setAttribute('aria-pressed', 'true'));
		// play() fails when the browser refuses (power saving): the video stays paused, as the
		// button then says. A click is a user gesture, which browsers rarely refuse.
		const play = () => video.play().catch(() => button.setAttribute('aria-pressed', 'true'));
		button.addEventListener('click', () => {
			if (video.paused) play();
			else video.pause();
		});
		const start = () => {
			video.src = src;
			button.hidden = false;
			play();
		};
		if (document.readyState === 'complete') start();
		else addEventListener('load', start, { once: true });
	}
</script>
