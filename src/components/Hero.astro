---
// The first screen of the home page, as in Película (#36): above, a code line printed as on the
// film (decorative) and the name; below, "Produtora audiovisual", the words (decorative) and the
// cue to Projects. The running strip between them, with its pause button, and the title in Shree
// Devanagari 714 come with #37. Nothing moves here yet.
import type { Language } from '../config/site';
import { dictionaries } from '../i18n';
import { sectionAnchor } from '../lib/paths';

interface Props {
	language: Language;
}

const { language } = Astro.props;
const t = dictionaries[language].hero;
const projectsTitle = dictionaries[language].projects.title;
---

{/* On a desktop it fills the screen under the header; below 700 px it takes only its content. */}
<section
	aria-labelledby="hero-title"
	class="grid min-h-[calc(100svh-var(--header-height)-28px)] grid-rows-[auto_1fr_auto] gap-[clamp(20px,3vh,36px)] px-gutter pt-[clamp(28px,6vh,72px)] pb-[clamp(20px,4vh,40px)] max-[700px]:min-h-0"
>
	<div class="grid gap-[clamp(12px,2vh,20px)]">
		<p class="type-code" aria-hidden="true">
			{t.code}
		</p>
		<h1
			id="hero-title"
			class="text-[clamp(3.1rem,9.6vw,9.8rem)] leading-[0.84] font-black tracking-[0.005em] type-name"
		>
			Droumond Productions
		</h1>
	</div>
	<div class="row-start-3 flex flex-wrap items-center gap-x-7 gap-y-3">
		<p class="text-[13px] tracking-[0.18em] uppercase">{t.line}</p>
		<p class="type-meta tracking-[0.16em]" aria-hidden="true">
			{t.words.join(' · ')}
		</p>
		<a
			href={`#${sectionAnchor('projects', language)}`}
			class="ml-auto text-xs tracking-[0.16em] text-amber uppercase no-underline max-[520px]:ml-0"
		>
			{projectsTitle} <span aria-hidden="true">↓</span>
		</a>
	</div>
</section>
