---
// The home page's first screen: the name, a looping film strip and the cue to Projects.
import { Image } from 'astro:assets';
import TitleDroumond from '../assets/hero/title-droumond.svg';
import TitleProductions from '../assets/hero/title-productions.svg';
import { STRIP_PHOTOS } from '../config/hero';
import type { Language } from '../config/site';
import { dictionaries } from '../i18n';
import { sectionAnchor } from '../lib/paths';
import Film from './Film.astro';

interface Props {
	language: Language;
}

const { language } = Astro.props;
const t = dictionaries[language].hero;
const projectsTitle = dictionaries[language].projects.title;

/** Frame numbers from 14, with the reel's name on every other frame. */
const edgeCodes = (index: number) => {
	const number = 14 + index;
	return {
		top: index % 2 ? `▸ ${number}` : `Droumond 2026 ▸ ${number}`,
		bottom: `${number}A`,
	};
};

/** A photo's width in its 3:2 frame, for `sizes`. The heights match --frame-height below. */
const frameSizes = ({ width, height }: { width: number; height: number }) => {
	const ratio = Math.max(width / height, 3 / 2).toFixed(3);
	return `(max-width: 700px) calc(${ratio} * clamp(120px, 26vh, 240px)), calc(${ratio} * clamp(120px, 28vh, 300px))`;
};
---

{/* On a desktop it fills the screen under the header; below 700 px it takes only its content. */}
<section
	aria-labelledby="hero-title"
	class="grid min-h-[calc(100svh-var(--header-height)-28px)] grid-rows-[auto_1fr_auto] gap-[clamp(20px,3vh,36px)] overflow-hidden pt-[clamp(28px,6vh,72px)] pb-[clamp(20px,4vh,40px)] max-[700px]:min-h-0"
>
	<div class="grid gap-[clamp(12px,2vh,20px)] px-gutter">
		<p class="type-code" aria-hidden="true">
			{t.code}
		</p>
		{/* The name in Shree Devanagari 714, drawn as SVG because the font cannot be hosted. Slightly
		    transparent through the colour, which the letters take as currentColor. */}
		<h1 id="hero-title" class="title text-paper/85">
			<span class="sr-only">Droumond Productions</span>
			<TitleDroumond aria-hidden="true" class="droumond" />
			<TitleProductions aria-hidden="true" class="productions" />
		</h1>
	</div>
	{/* The frames twice, so the loop has no seam. */}
	<div class="window" aria-hidden="true">
		<div class="tilt">
			<div class="strip" data-strip>
				{[0, 1].map(() => (
					<>
						<Film {...edgeCodes(0)}>
							<div class="frame title-card">
								<span class="logo-mark" />
							</div>
						</Film>
						{STRIP_PHOTOS.map((photo, index) => (
							<Film {...edgeCodes(index + 1)}>
								<Image
									src={photo.image}
									{...photo.files}
									sizes={frameSizes(photo.image)}
									alt=""
									loading="eager"
									class="frame"
									style={photo.focus && `object-position: ${photo.focus}`}
								/>
							</Film>
						))}
					</>
				))}
			</div>
		</div>
	</div>
	<div class="flex flex-wrap items-center gap-x-7 gap-y-3 px-gutter">
		<p class="text-[13px] tracking-[0.18em] uppercase">{t.line}</p>
		<p class="type-meta tracking-[0.16em]" aria-hidden="true">
			{t.words.join(' · ')}
		</p>
		{/* The button's height, so nothing moves when it appears. */}
		<div class="ml-auto flex min-h-[29px] items-center gap-[18px] max-[520px]:ml-0">
			<button
				type="button"
				data-strip-toggle
				data-pause={t.pause}
				data-resume={t.resume}
				hidden
				class="cursor-pointer border border-paper/14 px-2.5 py-2 text-[11px] leading-none tracking-[0.12em] uppercase hover:border-paper motion-reduce:hidden"
			>
				{t.pause}
			</button>
			<a
				href={`#${sectionAnchor('projects', language)}`}
				class="text-xs tracking-[0.16em] text-amber uppercase no-underline"
			>
				{projectsTitle} <span aria-hidden="true">↓</span>
			</a>
		</div>
	</div>
</section>

<script>
	// Runs only with JavaScript, which shows the pause button (WCAG 2.2.2). Reduced motion is in CSS.
	// The label changes, so no aria-pressed.
	const strip = document.querySelector<HTMLElement>('[data-strip]');
	const toggle = document.querySelector<HTMLButtonElement>('[data-strip-toggle]');
	if (strip && toggle) {
		strip.classList.add('running');
		toggle.hidden = false;
		toggle.addEventListener('click', () => {
			const paused = strip.classList.toggle('paused');
			toggle.textContent = (paused ? toggle.dataset.resume : toggle.dataset.pause) ?? '';
		});
		// Rests off screen; a manual pause stays.
		if ('IntersectionObserver' in window) {
			new IntersectionObserver(([entry]) => {
				strip.classList.toggle('resting', !entry.isIntersecting);
			}).observe(strip);
		}
	}
</script>

<style>
	/* One line, as wide as the block but no wider than the old title; widths in the font's units
	   (the SVGs' widths and the space between the words), so the words scale as one. */
	.title {
		--droumond: 4551;
		--space: 414;
		--productions: 5465;
		--line: calc(var(--droumond) + var(--space) + var(--productions));
		display: flex;
		align-items: flex-start;
		max-width: 94rem;
	}
	.title svg {
		display: block;
		height: auto;
	}
	.title .droumond {
		width: calc(100% * var(--droumond) / var(--line));
	}
	.title .productions {
		width: calc(100% * var(--productions) / var(--line));
		margin-left: calc(100% * var(--space) / var(--line));
	}
	/* Two lines on phones, PRODUCTIONS across the block, 130 units apart. */
	@media (max-width: 700px) {
		.title {
			flex-direction: column;
		}
		.title .droumond {
			width: calc(100% * var(--droumond) / var(--productions));
		}
		.title .productions {
			width: 100%;
			margin-left: 0;
			margin-top: calc(100% * 130 / var(--productions));
		}
	}
	/* Room above and below for the tilt. */
	.window {
		align-self: center;
		overflow: hidden;
		padding-block: clamp(36px, 5vw, 64px);
		margin-block: calc(-1 * clamp(20px, 3vw, 40px));
	}
	/* Wider than the screen, so the tilted ends never show. */
	.tilt {
		--frame-height: clamp(120px, 28vh, 300px);
		width: 116%;
		margin-left: -8%;
		transform: rotate(-3deg);
	}
	.strip {
		display: flex;
		width: max-content;
	}
	.frame {
		display: block;
		height: var(--frame-height);
		width: auto;
		max-width: none;
		aspect-ratio: 3 / 2;
		object-fit: cover;
		background: var(--color-ink);
	}
	.title-card {
		display: grid;
		place-items: center;
	}
	.title-card .logo-mark {
		width: 46%;
		aspect-ratio: 1;
		color: var(--color-paper);
	}
	@media (max-width: 700px) {
		.tilt {
			--frame-height: clamp(120px, 26vh, 240px);
		}
	}
	@media (prefers-reduced-motion: no-preference) {
		.strip.running {
			animation: strip-run 64s linear infinite;
		}
		.strip.paused,
		.strip.resting {
			animation-play-state: paused;
		}
	}
	@keyframes strip-run {
		to {
			transform: translate3d(-50%, 0, 0);
		}
	}
</style>
