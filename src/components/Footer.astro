---
// The footer, on every page, as in Película (#36): first the tail of the reel ("Fim da bobina"),
// decorative; then the founding year, the company's legal identification (#3), the email, the
// Privacy Policy, the profiles (links only, no embeds), the official Livro de Reclamações icon and,
// below, the consumer arbitration centre (#3, #18). No "legal information" page and no cookie
// banner (#3).
import type { Language } from '../config/site';
import { CONSUMER_ARBITRATION, CONTACT_EMAIL, LEGAL, SOCIAL } from '../config/site';
import { dictionaries } from '../i18n';
import { PAGES } from '../lib/paths';
import Film from './Film.astro';
// The official icon, from the platform's own "Imagens dos Logótipos" (livroreclamacoes.pt,
// Informação de Apoio), untouched: "preto negativo", white circle and letters on black, which read
// white on ink. The rules ask for an icon that contrasts with the background and links to the platform.
import complaintsBook from '../assets/livro-reclamacoes.png';

interface Props {
	language: Language;
}

const { language } = Astro.props;
const t = dictionaries[language].footer;
const legal = (Object.keys(LEGAL) as (keyof typeof LEGAL)[]).map((key) => ({
	label: t.legal[key],
	value: LEGAL[key],
}));
const links = [
	{ text: CONTACT_EMAIL, href: `mailto:${CONTACT_EMAIL}` },
	{ text: t.privacy, href: PAGES.privacy[language] },
	{ text: 'YouTube', href: SOCIAL.youtube, external: true },
	{ text: 'Instagram', href: SOCIAL.instagram, external: true },
];
// The national consumer portal, which the arbitration line points to for more information.
const CONSUMER_PORTAL = { name: 'Portal do Consumidor', url: 'https://www.consumidor.gov.pt' };
/** A site's address as the arbitration line shows it: `https://www.cniacc.pt` → `www.cniacc.pt`. */
const hostOf = (url: string) => new URL(url).host;
---

<div aria-hidden="true">
	<Film top={`Droumond 2026 ▸ 48 · ${t.reelEnd}`} bottom="48A">
		<div class="tail-frame grid place-items-center">
			<span class="bg-ink px-4 py-1.5 text-xs tracking-[0.24em] text-amber uppercase">
				{t.reelEnd}
			</span>
		</div>
	</Film>
</div>

<footer class="px-gutter pt-[clamp(40px,5vw,64px)] pb-[clamp(32px,4vw,48px)] text-xs/[1.6] text-muted">
	<div class="grid grid-cols-[1.1fr_1.7fr_1fr_auto] items-start gap-[clamp(24px,3vw,48px)] max-[960px]:grid-cols-2 max-[520px]:grid-cols-1">
		<div class="grid justify-items-start gap-3 text-paper">
			<span class="logo-mark block size-14" aria-hidden="true"></span>
			<div>
				<p class="text-[1.6rem] type-name">Droumond Productions</p>
				<p class="type-meta">{t.founded}</p>
			</div>
		</div>
		<dl class="grid grid-cols-[max-content_minmax(0,1fr)] gap-x-4 gap-y-1">
			{legal.map(({ label, value }) => (
				<>
					<dt class="text-paper">{label}</dt>
					{/* The values stay in Portuguese in every language: only the labels are translated. */}
					<dd lang="pt-PT" class="min-w-0">
						{value}
					</dd>
				</>
			))}
		</dl>
		<ul class="grid gap-2 text-paper">
			{links.map(({ text, href, external }) => (
				<li>
					<a
						href={href}
						class="[overflow-wrap:anywhere] hover:text-amber"
						{...(external && { target: '_blank', rel: 'noopener' })}
					>
						{text}
					</a>
				</li>
			))}
		</ul>
		<a
			href="https://www.livroreclamacoes.pt/inicio"
			target="_blank"
			rel="noopener"
			lang="pt-PT"
			class="block w-fit"
		>
			<img
				src={complaintsBook.src}
				width={complaintsBook.width}
				height={complaintsBook.height}
				alt="Livro de Reclamações"
			/>
		</a>
	</div>
	{/* Required since the company also works for consumers (Lei 144/2015, art. 18.º). The links are
	underlined: inside a sentence they must not rely on colour alone (WCAG 1.4.1). */}
	<p class="mt-[clamp(28px,3.5vw,44px)] max-w-[88ch]">
		{t.disputes.before} <span lang="pt-PT">{CONSUMER_ARBITRATION.name}</span> (
		<a
			href={CONSUMER_ARBITRATION.url}
			target="_blank"
			rel="noopener"
			class="underline underline-offset-3"
		>
			{hostOf(CONSUMER_ARBITRATION.url)}
		</a>
		). {t.disputes.more} <span lang="pt-PT">{CONSUMER_PORTAL.name}</span> (
		<a
			href={CONSUMER_PORTAL.url}
			target="_blank"
			rel="noopener"
			class="underline underline-offset-3"
		>
			{hostOf(CONSUMER_PORTAL.url)}
		</a>
		).
	</p>
</footer>

<style>
	/* The run-out after the last frame: diagonal stripes of stock and ink. */
	.tail-frame {
		height: clamp(64px, 9vw, 110px);
		background: repeating-linear-gradient(
			-45deg,
			var(--color-stock) 0 10px,
			var(--color-ink) 10px 20px
		);
	}
</style>
