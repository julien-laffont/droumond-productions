---
// The Contacto block (#7, #16), on the home page and at the end of the filming page: a title, a
// sentence and the address in large type, which is the email link itself (no separate button), then
// the Privacy Policy line. Only the filming page passes a subject; everywhere else the email opens
// blank. No template in the body.
import { CONTACT_EMAIL, type Language } from '../config/site';
import { dictionaries } from '../i18n';
import { PAGES, sectionAnchor } from '../lib/paths';

interface Props {
	language: Language;
	/** The email's subject, filled in for whoever writes (the filming page's). */
	subject?: string;
}

const { language, subject } = Astro.props;
const t = dictionaries[language].contact;
const anchor = sectionAnchor('contact', language);
const href = subject
	? `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(subject)}`
	: `mailto:${CONTACT_EMAIL}`;
// On a narrow screen the long address breaks before the @ (<wbr>), not in the middle of a word.
const atSign = CONTACT_EMAIL.indexOf('@');
---

<section
	id={anchor}
	aria-labelledby={`${anchor}-title`}
	class="border-t border-paper/14 px-gutter py-[clamp(56px,8vw,112px)]"
>
	<div class="reveal grid justify-items-start gap-[clamp(14px,2vw,22px)]">
		<h2 id={`${anchor}-title`} class="type-label">
			{t.title}
		</h2>
		<p class="max-w-[60ch] text-sm text-muted">{t.line}</p>
		{/* Whoever has no email program copies the address: a click or a drag over it selects all of
		    it at once (select-all). The size is Película's, with a smaller minimum (1.8 rem, not
		    2.1 rem), so that from 360 px the address still only breaks before the @. */}
		<a
			href={href}
			class="contact-email max-w-full font-name text-[clamp(1.8rem,8.4vw,7.4rem)] leading-[0.95] font-extrabold select-all [overflow-wrap:anywhere]"
		>
			{CONTACT_EMAIL.slice(0, atSign)}
			<wbr />
			{CONTACT_EMAIL.slice(atSign)}
		</a>
		{/* The link is underlined: inside a sentence it must not rely on colour alone (WCAG 1.4.1). */}
		<p class="text-xs text-muted">
			{t.privacyBefore}{' '}
			<a href={PAGES.privacy[language]} class="underline underline-offset-3">
				{t.privacy}
			</a>
			.
		</p>
	</div>
</section>

<style>
	/* An amber line grows under the address on hover, as in Película. */
	.contact-email {
		text-decoration: none;
		background: linear-gradient(var(--color-amber), var(--color-amber)) 0 100% / 0 3px no-repeat;
		transition: background-size 0.4s var(--ease);
	}
	.contact-email:hover {
		background-size: 100% 3px;
	}
	@media (prefers-reduced-motion: reduce) {
		.contact-email {
			transition: none;
		}
	}
</style>
