---
// The Filming service band of the home page (#16), right before Contacto: the one place that
// sells, on a band of film stock until #40 makes it a clapperboard. A small label, Julien's
// sentence as the title, one sentence and a button to the filming page.
import type { Language } from '../config/site';
import { dictionaries } from '../i18n';
import { PAGES } from '../lib/paths';

interface Props {
	language: Language;
}

const { language } = Astro.props;
const t = dictionaries[language].filming;
---

<section aria-labelledby="filming-band-title" class="bg-stock px-gutter py-[clamp(44px,6vw,80px)]">
	<div class="reveal grid grid-cols-[minmax(0,1fr)_auto] items-end gap-[clamp(20px,3vw,48px)] max-[760px]:grid-cols-1">
		<div>
			<p class="type-meta">{t.label}</p>
			<h2
				id="filming-band-title"
				class="mt-2.5 mb-3.5 max-w-[18ch] text-[clamp(1.9rem,3.6vw,3.1rem)] leading-[0.95] type-name"
			>
				{t.title}
			</h2>
			<p class="max-w-[52ch] text-muted">{t.line}</p>
		</div>
		<a
			href={PAGES.filming[language]}
			class="justify-self-start border border-paper px-[18px] py-3 text-xs font-bold tracking-[0.16em] uppercase hover:bg-paper hover:text-ink motion-safe:transition-colors motion-safe:duration-250 motion-safe:ease-(--ease)"
		>
			{t.button}
		</a>
	</div>
</section>
