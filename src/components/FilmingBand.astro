---
// The Filming service band of the home page, right before Contacto: on a clapperboard, a small
// label, the title, one sentence and a button to the filming page.
import type { Language } from '../config/site';
import { dictionaries } from '../i18n';
import { PAGES } from '../lib/paths';
import Slate from './Slate.astro';

interface Props {
	language: Language;
}

const { language } = Astro.props;
const t = dictionaries[language].filming;
---

<section
	aria-labelledby="filming-band-title"
	class="border-t border-paper/14 px-gutter pt-(--space-above) pb-[clamp(64px,9vw,128px)] [--space-above:clamp(64px,9vw,128px)]"
>
	<Slate language={language}>
		<p class="type-meta">{t.label}</p>
		<h2 id="filming-band-title" class="max-w-[16ch] text-[clamp(2rem,4.6vw,3.8rem)] type-name">
			{t.title}
		</h2>
		<p class="max-w-[52ch] text-[14px] text-muted">{t.line}</p>
		<a
			href={PAGES.filming[language]}
			class="mt-2 border border-paper px-[18px] py-3 text-xs font-bold tracking-[0.16em] uppercase hover:bg-paper hover:text-ink motion-safe:transition-colors motion-safe:duration-250 motion-safe:ease-(--ease)"
		>
			{t.button}
		</a>
	</Slate>
</section>
