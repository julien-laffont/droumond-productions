---
// The header, the same on every page, as in Película (#36): the symbol (to the home page), a
// timecode that runs with the scroll (decorative), the sections and the filming page, the language
// button, Instagram and YouTube, and Contacto. Over 880 px the links sit in a row; below, they move
// into a menu. Up to 520 px YouTube and Contacto leave the bar for the end of the menu, to make
// room for the timecode.
import InstagramIcon from '../assets/icons/instagram.svg';
import YouTubeIcon from '../assets/icons/youtube.svg';
import { SOCIAL, type Language } from '../config/site';
import { dictionaries } from '../i18n';
import { contactPath, PAGES, sectionPath, type PageId } from '../lib/paths';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
	language: Language;
	/** The current page, for the language button. Without one (the 404), there is no button. */
	page?: PageId;
}

const { language, page } = Astro.props;
const t = dictionaries[language].header;
const links = [
	{ text: t.projects, href: sectionPath('projects', language) },
	{ text: t.about, href: sectionPath('about', language) },
	{ text: t.cast, href: sectionPath('cast', language) },
	{ text: t.filming, href: PAGES.filming[language] },
];
const contact = { text: t.contact, href: contactPath(page, language) };
// The brands' official glyphs, in one colour. Their rules ask for the logo unaltered, so on hover
// only the amber line under it shows. On a phone, the ones not in the bar move into the menu.
const profiles = [
	{ name: 'Instagram', href: SOCIAL.instagram, Icon: InstagramIcon, inPhoneBar: true },
	{ name: 'YouTube', href: SOCIAL.youtube, Icon: YouTubeIcon, inPhoneBar: false },
];
const menuLink = 'block border-b border-paper/14 py-3 font-name text-[26px] uppercase';
---

<header class="sticky top-0 z-50 border-b border-paper/14 bg-ink">
	<div class="flex h-(--header-height) items-center gap-[clamp(12px,2.2vw,30px)] px-gutter">
		<a href={PAGES.home[language]} aria-label={t.home} class="block size-10 flex-none">
			<span class="logo-mark block size-full" aria-hidden="true"></span>
		</a>
		{/* Without JavaScript, and with less motion, it stays at the start of the reel. */}
		<span
			class="inline-flex items-baseline gap-2 text-xs tracking-[0.08em] whitespace-nowrap text-amber tabular-nums"
			aria-hidden="true"
		>
			<b class="text-[10px] font-normal tracking-[0.16em] text-amber-dim max-[520px]:hidden">TC</b>
			<span data-timecode>00:00:00:00</span>
		</span>
		<nav aria-label={t.nav} class="ml-auto max-[880px]:hidden">
			<ul class="flex gap-[clamp(14px,2vw,28px)]">
				{links.map(({ text, href }) => (
					<li>
						<a href={href} class="link-line text-xs tracking-[0.14em] uppercase">
							{text}
						</a>
					</li>
				))}
			</ul>
		</nav>
		<div class="flex items-center gap-[clamp(12px,2.2vw,30px)] max-[880px]:ml-auto">
			{page && <LanguageSwitcher language={language} page={page} />}
			<div class="flex flex-none">
				{profiles.map(({ name, href, Icon, inPhoneBar }) => (
					<a
						href={href}
						target="_blank"
						rel="noopener"
						aria-label={name}
						class:list={[
							'group grid size-10 place-items-center',
							!inPhoneBar && 'max-[520px]:hidden',
						]}
					>
						<span class="border-b border-transparent py-1.5 transition-[border-color] duration-200 ease-(--ease) group-hover:border-amber motion-reduce:transition-none">
							<Icon fill="currentColor" aria-hidden="true" class="block size-5" />
						</span>
					</a>
				))}
			</div>
			<a
				href={contact.href}
				class="flex-none bg-paper px-3.5 py-[9px] text-xs font-bold tracking-[0.14em] text-ink uppercase max-[520px]:hidden"
			>
				{contact.text}
			</a>
			<details class="min-[880px]:hidden" data-menu>
				<summary class="cursor-pointer list-none px-0.5 py-2 text-xs tracking-[0.14em] uppercase [&::-webkit-details-marker]:hidden">
					{t.menu}
				</summary>
				<nav
					aria-label={t.nav}
					class="absolute inset-x-0 top-(--header-height) border-b border-paper/14 bg-ink"
				>
					<ul class="px-gutter pt-2 pb-5">
						{links.map(({ text, href }) => (
							<li>
								<a href={href} class={menuLink}>
									{text}
								</a>
							</li>
						))}
						{profiles
							.filter(({ inPhoneBar }) => !inPhoneBar)
							.map(({ name, href }) => (
								<li class="min-[520px]:hidden">
									<a href={href} target="_blank" rel="noopener" class={menuLink}>
										{name}
										<span aria-hidden="true"> ↗</span>
									</a>
								</li>
							))}
						<li class="min-[520px]:hidden">
							<a href={contact.href} class={menuLink}>
								{contact.text}
							</a>
						</li>
					</ul>
				</nav>
			</details>
		</div>
	</div>
</header>

<script>
	// The menus (<details data-menu>) open and close without JavaScript. With it, they also close
	// when one of their links is tapped (on the home page the link only scrolls, and the menu would
	// stay over the content), when the other menu opens (they would cover each other), and with
	// Escape, which gives the focus back to the menu's button if it was inside the menu.
	const menus = document.querySelectorAll<HTMLDetailsElement>('details[data-menu]');
	for (const menu of menus) {
		menu.addEventListener('click', (event) => {
			if (event.target instanceof Element && event.target.closest('a')) menu.open = false;
		});
		menu.addEventListener('toggle', () => {
			if (!menu.open) return;
			for (const other of menus) if (other !== menu) other.open = false;
		});
	}
	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape') return;
		for (const menu of menus) {
			if (!menu.open) continue;
			const hadFocus = menu.contains(document.activeElement);
			menu.open = false;
			if (hadFocus) menu.querySelector('summary')?.focus();
		}
	});

	// The timecode (HH:MM:SS:FF, 25 frames per second): the whole page is a 4-minute reel, and the
	// scroll runs it. Whoever asked for less motion sees it still, at the start of the reel.
	const timecode = document.querySelector<HTMLElement>('[data-timecode]');
	const lessMotion = matchMedia('(prefers-reduced-motion: reduce)');
	const FPS = 25;
	const FRAMES = FPS * 60 * 4;
	const pad = (n: number) => String(n).padStart(2, '0');
	function showTimecode() {
		if (!timecode) return;
		const end = document.documentElement.scrollHeight - innerHeight;
		// Rounded up: a fractional scroll position at the very end still reaches the last frame.
		const progress = lessMotion.matches || end <= 0 ? 0 : Math.min(1, Math.ceil(scrollY) / end);
		const f = Math.round(progress * FRAMES);
		const seconds = f / FPS;
		timecode.textContent = [seconds / 3600, (seconds / 60) % 60, seconds % 60, f % FPS]
			.map((n) => pad(Math.floor(n)))
			.join(':');
	}
	let pending = false;
	addEventListener(
		'scroll',
		() => {
			if (pending) return;
			pending = true;
			requestAnimationFrame(() => {
				pending = false;
				showTimecode();
			});
		},
		{ passive: true },
	);
	lessMotion.addEventListener('change', showTimecode);
	showTimecode();
</script>
