---
// The home page, in one language (/ and /en/): the first screen, Projects, Sobre, Equipa, the filming
// band, then Contacto.
import type { Language } from '../config/site';
import { dictionaries } from '../i18n';
import Base from '../layouts/Base.astro';
import About from './About.astro';
import Contact from './Contact.astro';
import FilmingBand from './FilmingBand.astro';
import Hero from './Hero.astro';
import Projects from './Projects.astro';
import Team from './Team.astro';

interface Props {
	language: Language;
}

const { language } = Astro.props;
const t = dictionaries[language].home;
---

<Base language={language} page="home" title={t.title} description={t.description}>
	<main>
		<Hero language={language} />
		<Projects language={language} />
		<About language={language} />
		<Team language={language} />
		<FilmingBand language={language} />
		<Contact language={language} above="ink-2" />
	</main>
</Base>
