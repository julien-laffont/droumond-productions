---
// The Elenco section: a film strip of every Cast member (src/config/cast.ts) that runs by itself,
// each person on a frame of film ringed in grease pencil, with the name under it.
import { Image } from 'astro:assets';
import { CAST } from '../config/cast';
import { IMAGE_FILES } from '../config/image-files';
import type { Language } from '../config/site';
import { dictionaries } from '../i18n';
import { sheetFrame } from '../lib/cast-sheet';
import { sectionAnchor } from '../lib/paths';
import Film from './Film.astro';

interface Props {
	language: Language;
}

const { language } = Astro.props;
const t = dictionaries[language].cast;
const anchor = sectionAnchor('cast', language);

/** The strip crosses its own length in this time: the same speed whatever the number of people. */
const loop = `${CAST.length * 6}s`;
---

<section
	id={anchor}
	aria-labelledby={`${anchor}-title`}
	class="border-t border-paper/14 px-gutter py-[clamp(64px,9vw,128px)]"
>
	<div class="mb-[clamp(24px,3vw,40px)] flex flex-wrap items-center gap-x-5 gap-y-2.5">
		<h2 id={`${anchor}-title`} class="type-label">
			{t.title}
		</h2>
		<p class="ml-auto type-code" aria-hidden="true">
			{t.sheet}
		</p>
		{/* Shown by the script below, only while the strip runs (WCAG 2.2.2). The label changes, so no aria-pressed. */}
		<button
			type="button"
			data-cast-toggle
			data-pause={t.pause}
			data-resume={t.resume}
			hidden
			class="cursor-pointer border border-paper/14 px-2.5 py-2 text-[11px] leading-none tracking-[0.12em] uppercase hover:border-paper"
		>
			{t.pause}
		</button>
	</div>
	{/* With no script or less motion it is a strip to scroll, so it takes the keyboard's focus. */}
	<div
		class="window"
		data-cast-window
		style={`--loop: ${loop}`}
		role="group"
		tabindex="0"
		aria-labelledby={`${anchor}-title`}
	>
		<div class="track">
			{/* The list, then the same frames again, hidden: the loop has no seam. */}
			{[false, true].map((copy) => (
				<ul class:list={['sheet', { copy }]} aria-hidden={copy ? 'true' : undefined} inert={copy}>
					{CAST.map((person, index) => {
						const frame = sheetFrame(index);
						return (
							<li class="grid min-w-0 content-start gap-3.5">
								<Film top={frame.top} bottom={frame.bottom} side={7}>
									{/* The sizes are the card's width (--card below) minus the film's 7 px on each side. */}
									<Image
										src={person.photo}
										alt={copy ? '' : person.alt[language]}
										{...IMAGE_FILES.portrait}
										sizes="calc(clamp(220px, 19vw, 300px) - 14px)"
										class="block aspect-[4/5] w-full bg-ink object-cover"
									/>
									<svg
										class="pencil"
										viewBox="0 0 75 100"
										preserveAspectRatio="none"
										aria-hidden="true"
									>
										<path pathLength="1" d={frame.ring} />
									</svg>
								</Film>
								<h3 class="px-[7px] text-[clamp(1.25rem,1.8vw,1.75rem)] type-name">
									{person.name}
								</h3>
							</li>
						);
					})}
				</ul>
			))}
		</div>
	</div>
</section>

<script>
	// Runs the strip only with JavaScript and without a preference for less motion, also when the
	// preference changes with the page open.
	const view = document.querySelector<HTMLElement>('[data-cast-window]');
	const toggle = document.querySelector<HTMLButtonElement>('[data-cast-toggle]');
	if (view && toggle) {
		const motion = matchMedia('(prefers-reduced-motion: no-preference)');
		const sync = () => {
			view.classList.toggle('running', motion.matches);
			toggle.hidden = !motion.matches;
			// Nothing to scroll or focus while it runs by itself.
			view.scrollLeft = 0;
			if (motion.matches) view.removeAttribute('tabindex');
			else view.tabIndex = 0;
		};
		motion.addEventListener('change', sync);
		sync();
		toggle.addEventListener('click', () => {
			const paused = view.classList.toggle('paused');
			toggle.textContent = (paused ? toggle.dataset.resume : toggle.dataset.pause) ?? '';
		});
		// Rests off screen; a manual pause stays.
		if ('IntersectionObserver' in window) {
			new IntersectionObserver(([entry]) => {
				view.classList.toggle('resting', !entry.isIntersecting);
			}).observe(view);
		}
	}
</script>

<style>
	/* Out to the screen's edges. Without the script it scrolls sideways, from the left margin. */
	.window {
		--card: clamp(220px, 19vw, 300px);
		--left: max(var(--gutter), env(safe-area-inset-left, 0px));
		--right: max(var(--gutter), env(safe-area-inset-right, 0px));
		margin-inline: calc(-1 * var(--left)) calc(-1 * var(--right));
		overflow-x: auto;
		scrollbar-width: thin;
		scrollbar-color: var(--color-amber-dim) transparent;
		padding-bottom: 12px;
		scroll-padding-inline: var(--left) var(--right);
	}
	.window:focus-visible {
		outline-offset: -2px;
	}
	.track {
		display: flex;
		width: max-content;
		padding-inline: var(--left) var(--right);
	}
	/* The films touch. */
	.sheet {
		display: flex;
		flex: none;
	}
	.sheet > li {
		flex: none;
		width: var(--card);
	}
	.copy {
		display: none;
	}
	.window.running {
		overflow: hidden;
	}
	.running .track {
		padding-inline: 0;
		animation: run var(--loop) linear infinite;
	}
	.running .copy {
		display: flex;
	}
	.running.paused .track,
	.running.resting .track {
		animation-play-state: paused;
	}
	@keyframes run {
		to {
			transform: translate3d(-50%, 0, 0);
		}
	}

	/* The grease pencil, around the photo and over the bands of the film. */
	.pencil {
		position: absolute;
		inset: 22px 2px;
		width: calc(100% - 4px);
		height: calc(100% - 44px);
		overflow: visible;
		pointer-events: none;
	}
	/* One dash as long as the path: whole at offset 0, gone at offset 1. The width is in the box's
	   units (about 3.5 px on a desktop); a non-scaling stroke would break the dash's length. */
	.pencil path {
		fill: none;
		stroke: var(--color-grease);
		stroke-width: 1;
		stroke-linecap: round;
		stroke-linejoin: round;
		opacity: 0.92;
		stroke-dasharray: 1 1;
		stroke-dashoffset: 0;
	}
	li:nth-child(2n) .pencil {
		transform: rotate(1.2deg);
	}
	li:nth-child(3n) .pencil {
		transform: rotate(-1deg);
	}
	/* Only with a real hover: on a touch screen a tap would replay it. */
	@media (hover: hover) and (prefers-reduced-motion: no-preference) {
		li:hover .pencil path {
			animation: draw 0.7s var(--ease) both;
		}
	}
	@keyframes draw {
		from {
			stroke-dashoffset: 1;
		}
	}
</style>
