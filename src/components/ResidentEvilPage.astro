---
// The page of Resident Evil in one language. Its texts come from
// src/content/resident-evil/<language>.md, so Julien can change them without touching code.
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import cover1 from '../assets/resident-evil/episode-1.jpg';
import cover2 from '../assets/resident-evil/episode-2.jpg';
import cover3 from '../assets/resident-evil/episode-3.jpg';
import cover4 from '../assets/resident-evil/episode-4.jpg';
import { IMAGE_FILES } from '../config/image-files';
import { RESIDENT_EVIL_EPISODES, SOCIAL, type Language } from '../config/site';
import { dictionaries } from '../i18n';
import Base from '../layouts/Base.astro';
import Film from './Film.astro';

interface Props {
	language: Language;
}

/** Project titles are never translated. */
const TITLE = 'Resident Evil';
/** Each episode's cover, in the order of RESIDENT_EVIL_EPISODES. */
const COVERS = [cover1, cover2, cover3, cover4];

const { language } = Astro.props;
const t = dictionaries[language].residentEvil;
const entry = await getEntry('residentEvil', language);
if (!entry) {
	throw new Error(
		`Missing src/content/resident-evil/${language}.md: the page exists in every language.`,
	);
}
const { data } = entry;
const { Content } = await render(entry);
---

<Base
	language={language}
	page="residentEvil"
	title={`${TITLE} · Droumond Productions`}
	description={data.description}
>
	<main class="mx-auto grid max-w-[1600px] gap-[clamp(24px,3vw,36px)] px-gutter pt-[clamp(40px,5vw,72px)] pb-[clamp(64px,9vw,128px)]">
		<div class="grid gap-3">
			<p class="type-code" aria-hidden="true">
				{t.code}
			</p>
			<h1 class="text-[clamp(3rem,9vw,7.5rem)] type-name">{TITLE}</h1>
			<p class="type-meta text-balance">{data.line}</p>
		</div>

		<section aria-labelledby="episodes-title" class="episodes">
			<h2 id="episodes-title" class="title type-label">
				{t.episodes}
			</h2>
			<div class="covers grid min-w-0 gap-4">
				<ul class="grid grid-cols-2 gap-x-[clamp(12px,1.6vw,20px)] gap-y-[clamp(20px,2.4vw,28px)]">
					{RESIDENT_EVIL_EPISODES.map((reel, index) => {
						const number = String(index + 1).padStart(2, '0');
						return (
							<li class="min-w-0">
								<a
									href={reel}
									target="_blank"
									rel="noopener"
									aria-describedby="episodes-notice"
									class="episode grid gap-3"
								>
									<Film top={`▸ ${number} · ${TITLE}`} bottom={`${number}A`}>
										{/* The link's text names the episode; the cover only repeats the title. */}
										<Image
											src={COVERS[index]}
											alt=""
											{...IMAGE_FILES.episodeCover}
											sizes="(max-width: 760px) calc(50vw - 36px), 20vw"
											loading={index < 2 ? 'eager' : 'lazy'}
											class="block aspect-[9/16] w-full bg-ink object-cover"
										/>
									</Film>
									<span class="justify-self-start cta">
										<span aria-hidden="true">▶ </span>
										{`${t.episode} ${index + 1}`}
										<span aria-hidden="true"> ↗</span>
									</span>
								</a>
							</li>
						);
					})}
				</ul>
				<p id="episodes-notice" class="type-meta">
					{t.opensOnInstagram}
				</p>
			</div>
			<div class="text grid max-w-[62ch] min-w-0 content-start gap-[clamp(24px,3vw,36px)]">
				{/* The Project's name, in italics in the Markdown, shows upright in amber. */}
				<div class="grid gap-[1em] text-[clamp(1rem,1.2vw,1.1rem)] leading-[1.7] [&_em]:text-amber [&_em]:not-italic">
					<Content />
				</div>
				<dl class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 border-t border-paper/14 pt-4">
					{data.credits.map(({ role, name }) => (
						<>
							<dt class="type-meta leading-[1.9]">{role}</dt>
							<dd>{name}</dd>
						</>
					))}
				</dl>
				<div class="flex flex-wrap items-center gap-x-6 gap-y-3">
					<a href={SOCIAL.instagram} target="_blank" rel="noopener" class="cta">
						{t.follow}
						<span aria-hidden="true"> ↗</span>
					</a>
					<p class="type-meta">{t.comingSoon}</p>
				</div>
			</div>
		</section>
	</main>
</Base>

<style>
	/* Desktop: the episodes two by two on the left, the title and the text on the right. Phone: one
	   column, the episodes still two by two. */
	.episodes {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
		grid-template-areas:
			'covers title'
			'covers text';
		grid-template-rows: auto 1fr;
		gap: clamp(20px, 2.4vw, 32px) clamp(28px, 5vw, 80px);
		align-items: start;
	}
	.title {
		grid-area: title;
	}
	.covers {
		grid-area: covers;
	}
	.episode :global(img) {
		filter: saturate(0.85);
		transition: filter 0.4s var(--ease);
	}
	.episode:hover :global(img) {
		filter: saturate(1.1) brightness(1.06);
	}
	.text {
		grid-area: text;
	}
	@media (max-width: 760px) {
		.episodes {
			grid-template-columns: minmax(0, 1fr);
			grid-template-areas: 'title' 'covers' 'text';
			grid-template-rows: none;
		}
	}
</style>
