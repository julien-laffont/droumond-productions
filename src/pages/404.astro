---
// The 404 page (#17): one sentence in each language, each leading to the home page in its
// language. Its texts live here, not in the dictionaries, because the page holds both languages
// at once (English reviewed, #18).
// `astro preview` serves it for any unknown address with the 404 status; on the host,
// public/.htaccess does the same. No language button: the page has no other version.
import Base from '../layouts/Base.astro';
import { PAGES } from '../lib/paths';

const link = 'link-line mt-3 inline-block text-xs tracking-[0.14em] uppercase';
---

<Base
	language="pt"
	title="Página não encontrada · Droumond Productions"
	description="Esta página não existe no site da Droumond Productions."
>
	<main class="grid gap-[clamp(32px,5vw,56px)] px-gutter py-[clamp(64px,10vw,140px)]">
		<div>
			<h1 class="type-label">Esta página não existe.</h1>
			<a href={PAGES.home.pt} class={link}>
				Voltar à página inicial
			</a>
		</div>
		<div lang="en">
			<p class="type-label">This page does not exist.</p>
			<a href={PAGES.home.en} class={link}>
				Go back to the home page
			</a>
		</div>
	</main>
</Base>
